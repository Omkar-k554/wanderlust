<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
   <div class="col-8 offset-3">
      <h3>Listing Details:</h3>
   </div>   
      <div class="card col-6 offset-3" style="width: 25rem;">
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">
         <div class="card-body">
          <p class="card-text"> <b> <%= listing.title %> </b>
          <br><br>
          <%= listing.description %><br>
          &#8377;<%= listing.price.toLocaleString("en-IN") %><br>
          <%= listing.location%><br>
          <%= listing.country%>
          </p>
          <div class="btns">
            <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark edit-btn">Edit</a>
            <form method="POST" action="/listings/<%=listing._id %>?_method=DELETE">
              <button type="submit"  class="btn btn-dark offset-4"  onclick="return confirm(`Are you sure you want to delete this listing?`)">DELETE</button>
            </form>
          </div>
         </div>
      </div>
</div>