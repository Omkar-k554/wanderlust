<% layout("/layouts/boilerplate") %>
<body>
    <h3>All Listing</h3>
    <form method="GET" action="/listing/new">
         <button>Create New</button>
    </form>
    <ul>
        <% for(let Listing of allListing ){ %>
            <li><a href="/listing/<%= Listing._id %>"><%= Listing.title %></a></li>
        <%}%>
    </ul>
</body>


